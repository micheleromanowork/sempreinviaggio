# ─── Database Turso ──────────────────────────────────────────────────────────
# Per sviluppo locale usa un file SQLite:
TURSO_DATABASE_URL=file:./sempreinviaggio.db
# Per produzione (Turso cloud):
# TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
# TURSO_AUTH_TOKEN=<token>

# ─── Sessione ────────────────────────────────────────────────────────────────
# Segreto iron-session: almeno 32 caratteri casuali
SESSION_SECRET=cambia-con-una-stringa-casuale-di-almeno-32-caratteri

# ─── Cloudinary (media upload) ───────────────────────────────────────────────
# Registrati su cloudinary.com (piano free: 25 GB storage, 25 GB banda/mese)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Token Bearer per proteggere /api/cron/publish-scheduled
CRON_SECRET=cambia-con-una-stringa-casuale

# ─── SMTP (reset password via email) ─────────────────────────────────────────
# Usare SMTP Hostinger: smtp.hostinger.com porta 587
SMTP_PASS=

# ─── Sito pubblico ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In produzione:
# NEXT_PUBLIC_SITE_URL=https://sempreinviaggio.info

# ─── Admin iniziale (solo per db:seed) ───────────────────────────────────────
ADMIN_EMAIL=micheleromano.priv@gmail.com
ADMIN_PASSWORD=cambia-questa-password-subito
